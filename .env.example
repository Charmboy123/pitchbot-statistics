# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Football API Configuration (API-Football.com)
FOOTBALL_API_KEY=your_football_api_key_here
FOOTBALL_API_URL=https://v3.football.api-sports.io
FOOTBALL_API_PROVIDER=api_football

# Odds API Configuration (The Odds API)
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_URL=https://api.the-odds-api.com/v4
ODDS_API_PROVIDER=the_odds_api

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./elite_football.db
# For PostgreSQL on Render:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Admin Configuration
ADMIN_USER_IDS=your_telegram_user_id_here

# Analysis Configuration
MIN_PROBABILITY=0.75
MIN_EDGE=0.05
MIN_DATA_QUALITY=0.50
MIN_MODEL_CONSENSUS=0.60
MONTE_CARLO_SIMULATIONS=50000
CACHE_TTL=3600

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
WEBHOOK_URL=
PORT=8080
